#!/command/with-contenv bash
set -euo pipefail

source /usr/lib/sendspin-cli/common.sh

sendspin::read_options

sendspin::warn_if_output_changed_meaning

decision=$(sendspin::daemon_decision)

if [ "${decision}" = 'yes' ]; then
    sendspin::wait_for_socket "${AVAHI_SOCKET}"
fi

mkdir -p "${SENDSPIN_STATE_DIR}" "${SENDSPIN_RUN_DIR}"

# Created ahead of the write because a server value can carry credentials, and
# the file is something a support thread will ask a user to paste.
install -m 600 /dev/null "${SENDSPIN_CONF}"

# Only keys that have a value are written. The config parser treats a key's
# presence as meaning, so an empty `server =` would flip the player into
# dial-out mode and take the mDNS advertisement with it.
{
    printf 'name = %s\n' "${SENDSPIN_NAME}"
    printf 'output = %s\n' "${SENDSPIN_OUTPUT}"
    printf 'log-level = %s\n' "${SENDSPIN_LOG_LEVEL}"
    # These two deliberately override an upstream default rather than leaving it
    # alone, which is why they are written unconditionally where `buffer-ms`
    # below is not: upstream's defaults name the library this is built on, and a
    # server's device list should name the product instead. They are settable
    # from neither deployment because the product is this image, not something a
    # user assembles.
    printf 'manufacturer = %s\n' 'Music Assistant'
    printf 'product-name = %s\n' 'Local Audio'
    if [ -n "${SENDSPIN_BUFFER_MS}" ]; then
        printf 'buffer-ms = %s\n' "${SENDSPIN_BUFFER_MS}"
    fi
    if [ -n "${SENDSPIN_AUDIO_FORMAT}" ]; then
        printf 'audio-format = %s\n' "${SENDSPIN_AUDIO_FORMAT}"
    fi
    if [ -n "${SENDSPIN_ID}" ]; then
        printf 'id = %s\n' "${SENDSPIN_ID}"
    fi
    if [ -n "${SENDSPIN_HOOK_START}" ]; then
        printf 'hook-start = %s\n' "${SENDSPIN_HOOK_START}"
    fi
    if [ -n "${SENDSPIN_HOOK_STOP}" ]; then
        printf 'hook-stop = %s\n' "${SENDSPIN_HOOK_STOP}"
    fi
    if [ -n "${SENDSPIN_SERVER}" ]; then
        printf 'server = %s\n' "${SENDSPIN_SERVER}"
    fi
} > "${SENDSPIN_CONF}"

if [ -z "${SENDSPIN_SERVER}" ]; then
    sendspin::log "Advertising \"${SENDSPIN_NAME}\" over mDNS, waiting for a Music Assistant server to connect."
elif sendspin::server_is_mdns "${SENDSPIN_SERVER}"; then
    sendspin::log "Resolving the Music Assistant server over mDNS ($(sendspin::redact_server "${SENDSPIN_SERVER}")); this player is not advertised."
else
    sendspin::log "Dialling out to $(sendspin::redact_server "${SENDSPIN_SERVER}"); this player is not advertised."
fi

exec sendspin-cli \
    --config "${SENDSPIN_CONF}" \
    --state-dir "${SENDSPIN_STATE_DIR}" \
    --control-socket "${SENDSPIN_CONTROL_SOCKET}"
