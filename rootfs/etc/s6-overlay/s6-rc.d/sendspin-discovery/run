#!/command/with-contenv bash
set -euo pipefail

source /usr/lib/sendspin-cli/common.sh

# Publishing is advisory: a failure is a warning, and a run script that exited
# would have s6 restart it and post again forever.
if [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    sendspin::publish_discovery || true
fi

exec /command/s6-pause
